
import Sim::*

csp CTSpec csp-begin

CTSpec = Sim::CT::registerWrite.Sim::CT::o_out -> Sim::CT::endexec -> tock -> CTSpec 
		 |~|
		 Sim::CT::endexec -> tock -> CTSpec

csp-end

// It is deadlock free, as it continues to cycle.
assertion A0 : op is deadlock-free
// It is not *timed* deadlock-free, since it can continue to just execute cycles.
timed assertion A1 : op is not deadlock-free

assertion A2 : CT equals CTSpec in the failures divergences model